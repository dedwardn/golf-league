{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(./scripts/check.sh)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(grep:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Edit(pyproject.toml)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(scripts/**)",
      "Edit(docs/SPEC.md)",
      "Edit(docs/ARCHITECTURE.md)",
      "Edit(docs/DECISIONS.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
